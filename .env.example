# From developer.tesla.com after the app is approved
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=

# Must match a Redirect URI registered on the Tesla app exactly
TESLA_REDIRECT_URI=http://localhost:3000/api/auth/tesla/callback

# Public origin used for Allowed Origins and virtual-key pairing
# Production must be HTTPS, e.g. https://tripmapper.example.com
TESLA_APP_ORIGIN=http://localhost:3000

# Fleet API region for user tokens
# NA: https://fleet-api.prd.na.vn.cloud.tesla.com
# EU: https://fleet-api.prd.eu.vn.cloud.tesla.com
# CN: https://fleet-api.prd.cn.vn.cloud.tesla.com
TESLA_FLEET_API_BASE=https://fleet-api.prd.na.vn.cloud.tesla.com

# Random 32+ character secret used to encrypt session cookies
TESLA_SESSION_SECRET=replace-with-a-long-random-string

# HTTPS origin the Android Capacitor WebView should load (same as TESLA_APP_ORIGIN in production)
CAPACITOR_SERVER_URL=https://tripmapper.example.com
